# Copy to `.env` and fill in. Vite only exposes variables prefixed with VITE_.

# Where the WishBox API lives, including the version prefix.
# No address is baked into the build, so a deployed bundle needs this set in the
# host's build environment too — otherwise it falls back to the local API.
VITE_API_URL=https://be.wishboxdecor.in/api/v1
